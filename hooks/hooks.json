{
  "_comment": "Dispatcher unico: os hooks deste repo viajam com companions .neural-link.json e sao registrados pelo neural-link. Uma chamada por evento em vez de uma por hook.",
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "node ~/.copilot/neural-link/runtimes/neural-link/src/index.js",
        "timeout": 15,
        "managedBy": "neural-link:dispatcher"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node ~/.copilot/neural-link/runtimes/neural-link/src/index.js",
        "timeout": 15,
        "managedBy": "neural-link:dispatcher"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ~/.copilot/neural-link/runtimes/neural-link/src/index.js",
        "timeout": 20,
        "managedBy": "neural-link:dispatcher"
      }
    ],
    "SessionStart": [
      {
        "type": "command",
        "command": "node ~/.copilot/neural-link/runtimes/neural-link/src/index.js",
        "timeout": 15,
        "managedBy": "neural-link:dispatcher"
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node ~/.copilot/neural-link/runtimes/neural-link/src/index.js",
        "timeout": 15,
        "managedBy": "neural-link:dispatcher"
      }
    ]
  }
}
